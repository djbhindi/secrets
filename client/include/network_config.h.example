#pragma once

// Copy to network_config.h (Git ignores it). Select one transport:
// SD card standalone, USB serial, an existing 2.4 GHz network, or ESP32-hosted Wi-Fi.
// SD mode needs no laptop service or Wi-Fi credentials.
#define PHONE_CONNECTION_MODE PHONE_CONNECTION_SD

// Set to 1 for the separate WS2811 light controller. Move the cradle sense
// wire to GPIO32 first, then set PHONE_CRADLE_PIN to 32 below.
#define PHONE_STATUS_LIGHTS 0

// Used in PHONE_CONNECTION_SHARED_WIFI mode.
#define PHONE_WIFI_SSID "your-wifi-name"
#define PHONE_WIFI_PASSWORD "your-wifi-password"
#define PHONE_SERVER_HOST "your-laptop-name"

// Used in PHONE_CONNECTION_ESP32_AP mode. Use a distinct password for this
// network; it must contain at least eight characters.
#define PHONE_AP_SSID "Secrets-Phone"
#define PHONE_AP_PASSWORD "choose-a-new-password"
// Original phone wiring uses GPIO4 with a digital read; use 32 for ADC1 wiring.
#define PHONE_CRADLE_PIN 4
